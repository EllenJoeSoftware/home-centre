# Folder on the host that holds your movies, shows, music and photos.
# Windows (Docker Desktop) example: C:/Users/Wycliffe/Videos
# Mounted read-only at /media and added as the first media folder on first start.
MEDIA_PATH=C:/Users/Wycliffe/Videos

# Host folder whose sub-folders can be picked as media folders in Settings > Media folders.
# Mounted read-only at /host. Point it at something broad, e.g. a whole drive (D:/) or your
# user folder (C:/Users/Wycliffe). MEDIA_PATH is still mounted at /media as before.
BROWSE_PATH=C:/Users/Wycliffe

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Name the apps show when they find this server on the network.
SERVER_NAME=Home Centre

# Address the apps should use to reach the server, sent in LAN discovery replies.
# Recommended on Docker Desktop for Windows/macOS, where the container cannot see the
# host's LAN IP: set it to this PC's Wi-Fi/Ethernet address, e.g. http://192.168.1.10:8096
# Leave empty to let the apps use the address the reply came from.
PUBLIC_URL=

# HTTP port as reachable from the LAN. Only change it if you change the host side of
# the "8096:8096" port mapping in docker-compose.yml.
ADVERTISED_PORT=8096

WEB_PORT=8089
SCAN_INTERVAL_MINUTES=60
MAX_TRANSCODES=3
TZ=Africa/Johannesburg

# GHCR image owner (lower-case GitHub org/user) and tag
GHCR_OWNER=ellenjoesoftware
HC_VERSION=latest
