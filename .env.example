# Folder on the host that holds your movies, shows, music and photos.
# Windows (Docker Desktop) example: C:/Users/Wycliffe/Videos
MEDIA_PATH=C:/Users/Wycliffe/Videos

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

WEB_PORT=8089
SCAN_INTERVAL_MINUTES=60
MAX_TRANSCODES=3
TZ=Africa/Johannesburg

# GHCR image owner (lower-case GitHub org/user) and tag
GHCR_OWNER=ellenjoesoftware
HC_VERSION=latest
